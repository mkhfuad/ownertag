# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
BASE_URL=https://ownertag.de          # public URL, used in QR links & webhooks

# ── Data stores (pin to eu-central-1 / EU providers) ────────────────
DATABASE_URL=postgres://ownertag:ownertag@localhost:5432/ownertag
REDIS_URL=redis://localhost:6379

# ── Crypto ───────────────────────────────────────────────────────────
# 32-byte hex each. Generate: openssl rand -hex 32
# ponytail: direct AES-256-GCM master key; swap to AWS KMS envelope
# encryption (GenerateDataKey per record) before scale — see src/crypto.js
MASTER_KEY=
HMAC_KEY=
TOKEN_KEY=

# ── Cloudflare Turnstile (both empty = captcha disabled) ────────────
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# ── Twilio (EU region, German DIDs — BNetzA: domestic origination) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_RELAY_NUMBERS=+4930xxxxxxx,+4930yyyyyyy   # comma-separated German DID pool
TWILIO_SMS_SENDER=OWNERTAG                        # alpha sender, no registration needed in DE

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_NOTIFY=ownertag_notify               # pre-approved template name

# ── Email (SES eu-central-1 SMTP or any EU SMTP) ─────────────────────
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OwnerTag <no-reply@ownertag.de>"

# ── Shop ─────────────────────────────────────────────────────────────
ADMIN_KEY=                                   # openssl rand -hex 16 — guards /api/admin/orders
ORDER_NOTIFY_EMAIL=                          # where new-order notifications go (optional)
