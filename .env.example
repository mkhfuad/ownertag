# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
BASE_URL=https://ownertag.de          # public URL, used in QR links & webhooks

# ── Data stores (pin to eu-central-1 / EU providers) ────────────────
DATABASE_URL=postgres://ownertag:ownertag@localhost:5432/ownertag
REDIS_URL=redis://localhost:6379

# ── Crypto ───────────────────────────────────────────────────────────
# 32-byte hex each. Generate: openssl rand -hex 32
# ponytail: direct AES-256-GCM master key; swap to AWS KMS envelope
# encryption (GenerateDataKey per record) before scale — see src/crypto.js
MASTER_KEY=
HMAC_KEY=
TOKEN_KEY=

# ── Cloudflare Turnstile (both empty = captcha disabled) ────────────
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# ── Twilio (EU region, German DIDs — BNetzA: domestic origination) ──
TWILIO_ACCOUNT_SID=                               # starts with "AC…"  (Twilio Console home)
TWILIO_AUTH_TOKEN=                                # secret token       (Twilio Console home)
TWILIO_PHONE_NUMBER=+4930xxxxxxx                  # a real Twilio number (E.164) — preferred SMS sender
TWILIO_RELAY_NUMBERS=+4930xxxxxxx,+4930yyyyyyy   # comma-separated DID pool for masked CALLS
TWILIO_SMS_SENDER=OWNERTAG                        # alpha sender fallback (works in DE; many countries reject it)
# Optional: use Twilio Verify for OTP instead of our own SMS code (recommended).
# Create a Verify Service in the Console → its SID starts with "VA…".
TWILIO_VERIFY_SERVICE_SID=

# ── WhatsApp (Meta Cloud API) ────────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_TEMPLATE_NOTIFY=ownertag_notify               # pre-approved template name

# ── Email (SES eu-central-1 SMTP or any EU SMTP) ─────────────────────
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OwnerTag <no-reply@ownertag.de>"

# ── Shop ─────────────────────────────────────────────────────────────
ADMIN_KEY=                                   # openssl rand -hex 16 — guards /api/admin/orders
ORDER_NOTIFY_EMAIL=                          # where new-order notifications go (optional)

# ── Stripe subscription (€24.99 first year, then €9.99/yr) ───────────
# Create ONE Product with TWO Prices in the Stripe dashboard, then paste IDs:
#   STRIPE_PRICE_YEARLY = €9.99 / year, recurring
#   STRIPE_PRICE_SIGNUP = €15.00 one-time  (Stripe adds it to the FIRST invoice only)
# Leave all blank to keep billing disabled.
STRIPE_SECRET_KEY=                           # sk_test_… while testing, sk_live_… at launch
STRIPE_WEBHOOK_SECRET=                       # whsec_… from the webhook you create for /webhooks/stripe
STRIPE_PRICE_YEARLY=                         # price_… (the €9.99/yr recurring price)
STRIPE_PRICE_SIGNUP=                         # price_… (the €15.00 one-time price)
# Freemium gate: 1 = masked SMS/voice require an active subscription (free tier =
# web-portal + email). Leave empty until subscriptions are linked to tags.
FREEMIUM=
